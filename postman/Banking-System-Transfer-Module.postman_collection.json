{
  "info": {
    "_postman_id": "c01ada69-2eef-45d9-b715-ff238ba27954",
    "name": "Banking System Transfer Module",
    "description": "Inter-Account Transfer & Standing Order Module -- covers every endpoint in the API specification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-FIB-AUTH" },
      { "key": "value", "value": "{{apiKey}}" },
      { "key": "in", "value": "header" }
    ]
  },
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List all accounts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/accounts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounts"] }
          }
        },
        {
          "name": "Get account by IBAN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{sourceIban}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{sourceIban}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Execute same-currency transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('transferId', body.id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transfers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transfers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceIban\": \"{{sourceIban}}\",\n  \"destinationIban\": \"{{destinationIban}}\",\n  \"amount\": 100.00\n}"
            }
          }
        },
        {
          "name": "Execute cross-currency transfer (USD -> EUR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transfers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transfers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceIban\": \"{{sourceIban}}\",\n  \"destinationIban\": \"{{crossCurrencyDestinationIban}}\",\n  \"amount\": 100.00\n}"
            }
          }
        },
        {
          "name": "Duplicate idempotency key (run twice with the same key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "11111111-1111-4111-8111-111111111111" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transfers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transfers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceIban\": \"{{sourceIban}}\",\n  \"destinationIban\": \"{{destinationIban}}\",\n  \"amount\": 50.00\n}"
            }
          }
        },
        {
          "name": "Exceed daily transfer limit (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/transfers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transfers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceIban\": \"{{sourceIban}}\",\n  \"destinationIban\": \"{{destinationIban}}\",\n  \"amount\": 25000.00\n}"
            }
          }
        },
        {
          "name": "Get transfer by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "{{transferId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Ledger",
      "item": [
        {
          "name": "Query ledger (paginated, filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger?iban={{sourceIban}}&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger"],
              "query": [
                { "key": "iban", "value": "{{sourceIban}}" },
                { "key": "dateFrom", "value": "", "disabled": true },
                { "key": "dateTo", "value": "", "disabled": true },
                { "key": "type", "value": "DEBIT", "disabled": true },
                { "key": "minAmount", "value": "", "disabled": true },
                { "key": "maxAmount", "value": "", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Standing Orders",
      "item": [
        {
          "name": "Create standing order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('standingOrderId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/standing-orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "standing-orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceIban\": \"{{sourceIban}}\",\n  \"destinationIban\": \"{{destinationIban}}\",\n  \"amount\": 10.00,\n  \"cronExpression\": \"0 * * * * *\"\n}"
            }
          }
        },
        {
          "name": "List active standing orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/standing-orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "standing-orders"] }
          }
        },
        {
          "name": "Get standing order by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/standing-orders/{{standingOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "standing-orders", "{{standingOrderId}}"]
            }
          }
        },
        {
          "name": "Cancel standing order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/standing-orders/{{standingOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "standing-orders", "{{standingOrderId}}"]
            }
          }
        }
      ]
    }
  ]
}
